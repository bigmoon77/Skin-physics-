          "input": "phase04_test_environment/fixed_step.input.json",
          "expected": "phase04_test_environment/fixed_step.expected.json",
          "checks": [
            "fixed dt accumulator",
            "Pause/Step/Reset/Time Scale",
            "no dropped simulation time"
          ]
        },
        {
          "id": "P04_JSON_ROUNDTRIP",
          "input": "phase04_test_environment/scenario.input.json",
          "expected": "phase04_test_environment/scenario.expected.json",
          "checks": [
            "schema validation",
            "save-load-save semantic equality",
            "unknown extension preservation"
          ]
        },
        {
          "id": "P04_RUN_RESULT",
          "input": "phase04_test_environment/run_result.input.json",
          "expected": "phase04_test_environment/run_result.expected.json",
          "checks": [
            "scenario hash and IDs",
            "pass metrics and explicit unavailable GPU counters"
          ]
        }
      ],
      "automated_cases": [
        "P04_FIXED_STEP",
        "P04_FIXED_STEP_OVERLOAD"
      ],
      "unimplemented": [
        "Scenario JSON schema and unknown-field round trip",
        "Run Result serialization",
        "D3D11 GPU timestamp and DXGI memory telemetry"
      ]
