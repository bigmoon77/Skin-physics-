      "id": "collision_broadphase",
      "status": "partial",
      "acceptance_tests": [
        "T07",
        "T08",
        "T10",
        "T11",
        "T17",
        "T22"
      ],
      "cases": [
        {
          "id": "P07_VT_CONTACT",
