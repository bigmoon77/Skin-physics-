{
  "schema_version": 1,
  "golden_policy": {
    "inputs_immutable": true,
    "expected_outputs_reviewed": true,
    "exact_fields": [
      "topology",
      "indices",
      "IDs",
      "counts",
      "state_transitions",
      "schema_version"
    ],
    "numeric_tolerance_from_expected_file": true,
    "automatic_golden_update": false
  },
  "phases": [
    {
      "phase": 1,
      "id": "importer",
      "status": "automated",
      "acceptance_tests": [
        "importer OBJ/glTF",
        "unit and coordinate conversion",
        "skinning and animation import",
        "topology validation"
      ],
      "cases": [
        {
          "id": "P01_OBJ_QUAD",
          "input": "phase01_importer/quad.obj",
          "expected": "phase01_importer/obj_quad.expected.json",
          "checks": [
            "negative OBJ indices",
            "quad triangulates to 2 triangles",
            "explicit centimeter-to-meter scale",
            "MTL PBR factors",
            "generated normals and tangents"
          ]
        },
        {
          "id": "P01_GLTF_SKIN_ANIMATION",
          "input": "phase01_importer/skinned_triangle.gltf",
          "expected": "phase01_importer/gltf_skin.expected.json",
          "checks": [
            "3 positions and indices",
            "skin joints and normalized weights",
            "inverse bind matrix",
            "custom vertex group",
            "LINEAR animation keys"
          ]
        },
        {
          "id": "P01_OBJ_UNIT_ERROR",
          "input": "phase01_importer/unit_missing.obj",
          "expected": "phase01_importer/unit_missing.expected.json",
          "checks": [
            "missing explicit OBJ unit scale rejected"
          ]
        }
      ]
    },
    {
      "phase": 2,
      "id": "physics_mesh_skin_weights_cache",
      "status": "partial",
      "acceptance_tests": [
        "T13",
        "T26"
      ],
      "cases": [
        {
          "id": "P02_SINGLE_TET",
          "input": "phase02_physics_mesh/single_tet.msh",
          "expected": "phase02_physics_mesh/single_tet.expected.json",
          "checks": [
            "signed orientation repair",
            "rest volume and gradients",
            "quality and dihedral",
            "boundary count",
            "mass conservation",
            "CSR"
          ]
        },
        {
          "id": "P02_TWO_TET",
          "input": "phase02_physics_mesh/two_tet_shared_face.msh",
          "expected": "phase02_physics_mesh/two_tet.expected.json",
          "checks": [
            "shared face removed from boundary",
            "two element mass conservation",
            "boundary topology"
          ]
        },
        {
          "id": "P02_CENTER_STAR",
          "input": "phase02_physics_mesh/center_star.msh",
          "expected": "phase02_physics_mesh/center_star_skin_weights.expected.json",
          "checks": [
            "closest-surface barycentric transfer",
            "positive graph Laplacian",
            "PCG convergence and analytical interior weights"
          ]
        },
        {
          "id": "P02_CACHE",
          "input": "single_tet PhysicsMesh",
          "expected": "round-trip identity/checksum assertions",
          "checks": [
            "save/load equality",
            "stale identity needs rebuild",
            "checksum corruption needs rebuild",
            "invalid payload rejected"
          ]
        },
        {
          "id": "P02_RESOLUTION_SETTINGS",
          "input": "phase02_physics_mesh/resolution.input.json",
          "expected": "phase02_physics_mesh/resolution.expected.json",
          "checks": [
            "target tetrahedron edge length/count recorded",
            "max_tet_count blocks overflow",
            "generator options participate in cache identity"
          ]
        }
      ],
      "fixture_ready_acceptance_tests": [
        "T25"
      ]
    },
    {
      "phase": 3,
      "id": "render_binding_feedback",
      "status": "partial",
      "acceptance_tests": [
        "T12",
        "T27"
      ],
      "cases": [
        {
          "id": "P03_TET_INTERIOR",
          "input": "phase03_render_binding/tet_binding.input.json",
          "expected": "phase03_render_binding/tet_binding.expected.json",
          "checks": [
            "four-vertex barycentric binding",
            "rest pose error",
            "CPU feedback updates positions while preserving UV/color/material/index attributes"
          ]
        },
        {
          "id": "P03_BOUNDARY_OFFSET",
          "input": "phase03_render_binding/tet_binding.input.json",
          "expected": "phase03_render_binding/tet_binding.expected.json",
          "checks": [
            "closest boundary triangle",
            "Rest Pose offset mapped through local basis"
          ]
        },
        {
          "id": "P03_INVALID_BINDING",
          "input": "phase03_render_binding/tet_binding.invalid.json",
          "expected": "phase03_render_binding/tet_binding.invalid.expected.json",
          "checks": [
            "degenerate/too-distant binding is diagnosed"
          ]
        }
      ],
      "automated_cases": [
        "P03_TET_INTERIOR",
        "P03_BOUNDARY_OFFSET",
        "P03_INVALID_BINDING"
      ],
      "unimplemented": [
        "D3D11 GPU feedback dispatch and GPU readback comparison",
        "Cloth surface binding"
      ]
    },
    {
