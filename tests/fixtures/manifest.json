        {
          "id": "P06_INVERSION",
          "input": "phase06_soft_body/tet_deformation.input.json",
          "expected": "phase06_soft_body/tet_deformation.expected.json",
          "checks": [
            "inversion diagnostic and finite penalty path"
          ]
        }
      ],
      "automated_cases": [
        "P06_COROTATIONAL_FEM_GOLDEN",
        "P06_INVERSION_ROLLBACK"
      ],
      "unimplemented": [
        "Soft Body global force gather and time integration",
        "GPU FEM element kernels and accumulation",
        "CFL/substep controller and animation-tracking coupling"
      ]
    },
    {
